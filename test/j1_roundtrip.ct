/*
 * J1 acceptance driver: decode -> encode round trips plus the access contract.
 *
 * Build and run (the multi-file form is the one that catches generated-header
 * and incomplete-type problems, so it is the one used here):
 *
 *   CT_STD_DIR=/Users/samxx/trae-ws/ct-lang/lib/std \
 *     ~/.local/bin/ct build test/j1_roundtrip.ct -I src -o /tmp/j1_roundtrip
 *   /tmp/j1_roundtrip > /tmp/j1_roundtrip.out
 *   diff /tmp/j1_roundtrip.out test/j1_roundtrip.expected.out
 *
 * Exit code is 0 only when every line matches the golden file.
 */
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

import json;

static int total = 0;
static int failed = 0;

static void check(int cond, char *name)
{
    total = total + 1;
    if (cond) {
        printf("ok %d %s\n", total, name);
    } else {
        failed = failed + 1;
        printf("not ok %d %s\n", total, name);
    }
}

static int roundtrip(char *name, char *text, char *want)
{
    JsonError err;
    JsonValue *root;
    char *out;
    int same;
    root = json_decode(text, (int)strlen(text), &err);
    if (root == 0) {
        fprintf(stderr, "# %s: decode failed code=%d offset=%d\n", name, err.code, err.offset);
        check(0, name);
        return 0;
    }
    out = json_encode(root);
    same = out != 0 && strcmp(out, want) == 0;
    if (!same)
        fprintf(stderr, "# %s: got [%s] want [%s]\n", name, out == 0 ? "(null)" : out, want);
    check(same, name);
    free(out);
    json_free(root);
    return same;
}

static void expect_err(char *name, char *text, int code, int off)
{
    JsonError err;
    JsonValue *root;
    int good;
    root = json_decode(text, (int)strlen(text), &err);
    good = root == 0 && err.code == code && err.offset == off;
    if (!good)
        fprintf(stderr, "# %s: root-null=%d code=%d offset=%d want code=%d offset=%d\n",
                name, root == 0, err.code, err.offset, code, off);
    check(good, name);
    json_free(root);
}

/* `depth` nested empty arrays: "[...[]...]". */
static char *nest(int depth)
{
    int i;
    int n = depth * 2;
    char *s = malloc((size_t)n + 1);
    if (s == 0) abort();
    for (i = 0; i < depth; i = i + 1) s[i] = '[';
    for (i = 0; i < depth; i = i + 1) s[depth + i] = ']';
    s[n] = 0;
    return s;
}

static void access_contract(void)
{
    char *text = "{\"a\":1,\"n\":null,\"s\":\"x\",\"arr\":[10,20],\"obj\":{\"k\":true},\"f\":2.5}";
    JsonError err;
    JsonValue *root = json_decode(text, (int)strlen(text), &err);
    JsonValue *missing;
    JsonValue *explicit_null;
    char *null_key = 0;
    if (root == 0) {
        fprintf(stderr, "# access fixture failed code=%d offset=%d\n", err.code, err.offset);
        check(0, "access fixture decodes");
        return;
    }
    check(err.code == JSON_OK && err.offset == (int)strlen(text), "decode reports JSON_OK at len");
    check(json_tag(root) == JSON_OBJ, "root tag is JSON_OBJ");
    check(json_obj_len(root) == 6, "object has six keys");
    check(json_arr_len(root) == 0, "array length defaults to 0 on an object");

    missing = json_member(root, "zz");
    check(missing == 0, "missing key answers 0");
    check(json_tag(missing) == -1, "tag of a missing node is -1");
    explicit_null = json_member(root, "n");
    check(explicit_null != 0, "explicit null answers a node");
    check(json_tag(explicit_null) == JSON_NULL, "explicit null has tag JSON_NULL");
    check(json_is_null(explicit_null) == 1, "is_null is true for explicit null");
    check(json_is_null(missing) == 0, "is_null is false for a missing node");

    check(json_as_int(json_member(root, "a")) == 1, "as_int reads an integer");
    check(json_as_num(json_member(root, "a")) == 1.0, "as_num widens an integer");
    check(json_as_num(json_member(root, "f")) == 2.5, "as_num reads a double");
    check(strcmp(json_as_str(json_member(root, "s")), "x") == 0, "as_str reads a string");
    check(json_as_int(json_member(root, "s")) == 0, "as_int on a string answers 0");
    check(json_as_str(json_member(root, "obj")) == 0, "as_str on an object answers 0");
    check(json_as_bool(explicit_null) == 0, "as_bool on null answers 0");
    check(json_as_int(missing) == 0, "as_int on a missing node answers 0");

    check(json_obj_len(json_member(root, "arr")) == 0, "obj_len on an array answers 0");
    check(json_arr_len(json_member(root, "obj")) == 0, "arr_len on an object answers 0");
    check(json_as_obj(json_member(root, "arr")) == 0, "as_obj on an array answers 0");
    check(json_as_arr(json_member(root, "obj")) == 0, "as_arr on an object answers 0");
    check(json_as_obj(root) != 0, "as_obj on an object is non-null");
    check(json_as_arr(json_member(root, "arr")) != 0, "as_arr on an array is non-null");

    check(json_arr_len(json_member(root, "arr")) == 2, "array length is 2");
    check(json_as_int(json_at(json_member(root, "arr"), 0)) == 10, "at(0) is 10");
    check(json_as_int(json_at(json_member(root, "arr"), 1)) == 20, "at(1) is 20");
    check(json_at(json_member(root, "arr"), 2) == 0, "at(len) answers 0");
    check(json_at(json_member(root, "arr"), -1) == 0, "at(-1) answers 0");
    check(json_at(root, 0) == 0, "at on an object answers 0");
    check(json_member(json_member(root, "arr"), "x") == 0, "member on an array answers 0");
    check(json_member(root, null_key) == 0, "member with a NULL key answers 0");

    check(strcmp(json_obj_key_at(root, 0), "a") == 0, "key_at(0) keeps insertion order");
    check(strcmp(json_obj_key_at(root, 1), "n") == 0, "key_at(1) keeps insertion order");
    check(json_obj_key_at(root, 6) == 0, "key_at out of range answers 0");
    check(json_obj_key_at(json_member(root, "arr"), 0) == 0, "key_at on an array answers 0");

    json_free(root);
}

static void numeric_edges(void)
{
    JsonError err;
    char *text = "{\"max\":9223372036854775807,\"min\":-9223372036854775808,\"over\":9223372036854775808}";
    JsonValue *root = json_decode(text, (int)strlen(text), &err);
    if (root == 0) {
        check(0, "numeric fixture decodes");
        return;
    }
    check(json_tag(json_member(root, "max")) == JSON_INT, "int64 max stays JSON_INT");
    check(json_as_int(json_member(root, "max")) == 9223372036854775807, "int64 max is exact");
    check(json_tag(json_member(root, "min")) == JSON_NUM, "int64 min falls back to JSON_NUM");
    check(json_as_num(json_member(root, "min")) == -9223372036854775808.0, "int64 min is exact as a double");
    check(json_tag(json_member(root, "over")) == JSON_NUM, "int64 max + 1 falls back to JSON_NUM");
    json_free(root);
}

static void error_contract(void)
{
    JsonError err;
    char *deep64;
    char *deep65;
    JsonValue *root;

    expect_err("empty input is EOF", "", JSON_ERR_EOF, 0);
    expect_err("whitespace only is EOF", "  ", JSON_ERR_EOF, 2);
    expect_err("second root is trailing", "{} {}", JSON_ERR_TRAILING, 3);
    expect_err("unterminated object is EOF", "{", JSON_ERR_EOF, 1);
    expect_err("unterminated string is EOF", "\"abc", JSON_ERR_EOF, 4);
    expect_err("missing value is syntax", "{\"a\":}", JSON_ERR_SYNTAX, 5);
    expect_err("trailing comma in array is syntax", "[1,]", JSON_ERR_SYNTAX, 3);
    expect_err("missing colon is syntax", "{\"a\" 1}", JSON_ERR_SYNTAX, 5);
    expect_err("leading zero is a number error", "01", JSON_ERR_NUMBER, 1);
    expect_err("bare minus is a number error", "-", JSON_ERR_NUMBER, 1);
    expect_err("dot without digits is a number error", "1.", JSON_ERR_NUMBER, 2);
    expect_err("exponent without digits is a number error", "1e", JSON_ERR_NUMBER, 2);
    expect_err("plus prefix is syntax", "+1", JSON_ERR_SYNTAX, 0);
    expect_err("unknown escape is an escape error", "\"\\q\"", JSON_ERR_ESCAPE, 3);
    expect_err("bad hex is a unicode error", "\"\\u00zz\"", JSON_ERR_UNICODE, 5);
    expect_err("lone high surrogate is a surrogate error", "\"\\ud800\"", JSON_ERR_SURROGATE, 7);
    expect_err("control byte in string is a string error", "\"a\nb\"", JSON_ERR_STRING, 2);

    root = json_decode(0, 0, &err);
    check(root == 0 && err.code == JSON_ERR_EOF && err.offset == 0, "NULL text is EOF");
    json_free(root);

    deep64 = nest(64);
    deep65 = nest(65);
    root = json_decode(deep64, (int)strlen(deep64), &err);
    check(root != 0 && err.code == JSON_OK, "64 levels decode");
    json_free(root);
    root = json_decode(deep65, (int)strlen(deep65), &err);
    check(root == 0 && err.code == JSON_ERR_DEPTH && err.offset == 64, "65 levels stop at depth 64");
    json_free(root);
    free(deep64);
    free(deep65);
}

int main(void)
{
    char *deep64 = nest(64);
    check(json_encode(0) == 0, "encode of a NULL tree answers 0");
    check(json_tag(0) == -1, "tag of a NULL tree is -1");

    roundtrip("round trip: empty object", "{}", "{}");
    roundtrip("round trip: empty array", "[]", "[]");
    roundtrip("round trip: scalars",
              "{\"t\":true,\"f\":false,\"n\":null}", "{\"t\":true,\"f\":false,\"n\":null}");
    roundtrip("round trip: nested",
              "{\"server\":{\"host\":\"localhost\",\"port\":8080},\"tags\":[\"a\",\"b\"],\"ok\":false}",
              "{\"server\":{\"host\":\"localhost\",\"port\":8080},\"tags\":[\"a\",\"b\"],\"ok\":false}");
    roundtrip("round trip: nested arrays", "[[1,2],[3,4],[]]", "[[1,2],[3,4],[]]");
    roundtrip("round trip: whitespace normalised", " { \"a\" : [ 1 , 2 ] } ", "{\"a\":[1,2]}");
    roundtrip("round trip: escapes",
              "{\"s\":\"a\\\"b\\\\c\\nd\\te\"}", "{\"s\":\"a\\\"b\\\\c\\nd\\te\"}");
    roundtrip("round trip: unicode escapes",
              "{\"u\":\"\\u0041\\u00e9\\u20ac\\ud83d\\ude00\"}", "{\"u\":\"Aé€😀\"}");
    roundtrip("round trip: numbers",
              "{\"i\":-42,\"big\":9007199254740993,\"d\":1.5,\"neg\":-2.25}",
              "{\"i\":-42,\"big\":9007199254740993,\"d\":1.5,\"neg\":-2.25}");
    roundtrip("round trip: number normalisation", "{\"e\":1e3,\"f\":0.10}", "{\"e\":1000,\"f\":0.1}");
    roundtrip("round trip: duplicate key last wins", "{\"a\":1,\"a\":2}", "{\"a\":2}");
    roundtrip("round trip: empty string", "{\"s\":\"\"}", "{\"s\":\"\"}");
    roundtrip("round trip: escaped key", "{\"\\u0061\":1}", "{\"a\":1}");
    roundtrip("round trip: 64 levels", deep64, deep64);

    access_contract();
    numeric_edges();
    error_contract();
    free(deep64);

    if (failed == 0) {
        printf("all checks passed\n");
        return 0;
    }
    printf("%d of %d checks failed\n", failed, total);
    return 1;
}
