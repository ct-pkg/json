/*
 * ct-json 0.1.0 acceptance driver (CT v0.52.0 rewrite).
 *
 * Covers decode/encode round trips, the access contract, the parse error
 * codes, and the reference-counted node lifecycle. Shard 1 of the rewrite:
 * keys are still `char *` and array access still uses `json_at`; later shards
 * switch keys to `Str`, add `get_idx` / `set_idx` / `push`, and hang
 * `get` / `set` off `JsonRef` for the subscript protocol.
 *
 * The counters travel through a `struct Stats *` on purpose: a file-scope
 * counter plus a `check()` helper plus any `char *` parameter trips the
 * v0.52.0 false positive `a borrowed view is invalidated by a later mutation
 * of its container` (known compiler defect, not a test bug).
 *
 * Build and run:
 *
 *   CT_STD_DIR=/Users/samxx/trae-ws/ct-lang/lib/std \
 *     ~/.local/bin/ct build test/j1_roundtrip.ct -I src -o /tmp/ctjson_test
 *   /tmp/ctjson_test
 *
 * Exit code is 0 only when every check passes. Negative checks print
 * "not ok"; the failure count is the last line.
 */
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

import json;

struct Stats {
    int total;
    int failed;
}

static void check(struct Stats *st, int cond, char *name)
{
    st->total = st->total + 1;
    if (cond) {
        printf("ok %d %s\n", st->total, name);
    } else {
        st->failed = st->failed + 1;
        printf("not ok %d %s\n", st->total, name);
    }
}

static JsonRef empty_ref(void)
{
    JsonRef r;
    r.p = 0;
    return r;
}

static JsonRef member_cstr(JsonRef v, char *k)
{
    Str s = str_from(k);
    JsonRef r = json_member(v, s);
    s.release();
    return r;
}

static int has_cstr(JsonRef v, char *k)
{
    Str s = str_from(k);
    int r = v.has(s);
    s.release();
    return r;
}

static void roundtrip(struct Stats *st, char *name, char *text, char *want)
{
    JsonRef root = empty_ref();
    char *out;
    int same;
    int rc;
    rc = json_decode(text, (int)strlen(text), &root);
    if (rc != JSON_OK) {
        fprintf(stderr, "# %s: decode failed rc=%d\n", name, rc);
        check(st, 0, name);
        return;
    }
    out = json_encode(root);
    same = out != 0 && strcmp(out, want) == 0;
    if (!same)
        fprintf(stderr, "# %s: got [%s] want [%s]\n", name, out == 0 ? "(null)" : out, want);
    check(st, same, name);
    free(out);
    json_free(root);
}

static void expect_err(struct Stats *st, char *name, char *text, int code)
{
    JsonRef root = empty_ref();
    int rc;
    rc = json_decode(text, (int)strlen(text), &root);
    if (rc != code) {
        fprintf(stderr, "# %s: rc=%d want=%d\n", name, rc, code);
        check(st, 0, name);
    } else {
        check(st, root.p == 0, name);
    }
    json_free(root);
}

/* `depth` nested empty arrays: "[...[]...]". */
static char *nest(int depth)
{
    int i;
    int n = depth * 2;
    char *s = malloc((size_t)n + 1);
    if (s == 0) abort();
    for (i = 0; i < depth; i = i + 1) s[i] = '[';
    for (i = 0; i < depth; i = i + 1) s[depth + i] = ']';
    s[n] = 0;
    return s;
}

static void lifecycle_contract(struct Stats *st)
{
    JsonRef root = empty_ref();
    JsonRef child;
    JsonRef nested;
    int rc;
    long long x = 0;

    rc = json_decode("{\"a\":{\"x\":7}}", 13, &root);
    check(st, rc == JSON_OK, "lifecycle fixture decodes");
    if (rc != JSON_OK) return;

    check(st, root.p != 0 && root.p->refs == 1, "a fresh root is one reference");
    json_retain(root);
    check(st, root.p->refs == 2, "retain adds one reference");
    json_release(root);
    check(st, root.p->refs == 1, "release drops one reference");

    child = member_cstr(root, "a");
    check(st, child.p != 0 && child.p->refs == 1, "a member is borrowed, not retained");
    json_retain(child);
    check(st, child.p->refs == 2, "retain on a borrowed member is explicit");

    json_release(root);            /* frees the tree, drops one child ref */
    check(st, child.p->refs == 1, "child survives the container release");

    nested = member_cstr(child, "x");
    check(st, json_as_int(nested, &x) == JSON_OK && x == 7, "child is readable after the parent is gone");
    json_free(child);
}

static void access_contract(struct Stats *st)
{
    char *text = "{\"a\":1,\"n\":null,\"s\":\"x\",\"arr\":[10,20],\"obj\":{\"k\":true},\"f\":2.5}";
    JsonRef root = empty_ref();
    JsonRef missing;
    JsonRef explicit_null;
    JsonRef arr;
    char *null_key = 0;
    long long iv = 0;
    double dv = 0.0;
    int bv = 0;
    int slen = -1;
    char *s;
    int rc;

    rc = json_decode(text, (int)strlen(text), &root);
    if (rc != JSON_OK) {
        fprintf(stderr, "# access fixture failed rc=%d\n", rc);
        check(st, 0, "access fixture decodes");
        return;
    }
    check(st, json_last_error() == JSON_OK, "decode leaves last_error at JSON_OK");
    check(st, json_tag(root) == JSON_TAG_OBJ, "root tag is JSON_TAG_OBJ");
    check(st, json_obj_len(root) == 6, "object has six keys");
    check(st, json_arr_len(root) == -1, "array length is -1 on an object");

    missing = member_cstr(root, "zz");
    check(st, missing.p == 0, "missing key answers an empty handle");
    check(st, json_tag(missing) == -1, "tag of an empty handle is -1");
    explicit_null = member_cstr(root, "n");
    check(st, explicit_null.p != 0, "explicit null answers a node");
    check(st, json_tag(explicit_null) == JSON_TAG_NULL, "explicit null has tag JSON_TAG_NULL");
    check(st, json_is_null(explicit_null) == 1, "is_null is true for explicit null");
    check(st, json_is_null(missing) == 0, "is_null is false for an empty handle");

    check(st, json_as_int(member_cstr(root, "a"), &iv) == JSON_OK && iv == 1, "as_int reads an integer literal");
    check(st, json_as_double(member_cstr(root, "a"), &dv) == JSON_OK && dv == 1.0, "as_double widens an integer literal");
    check(st, json_as_double(member_cstr(root, "f"), &dv) == JSON_OK && dv == 2.5, "as_double reads a decimal");
    s = json_as_str(member_cstr(root, "s"), &slen);
    check(st, s != 0 && slen == 1 && s[0] == 'x', "as_str reads a string with its length");
    iv = 0;
    check(st, json_as_int(member_cstr(root, "s"), &iv) == JSON_ERR_TYPE && iv == 0, "as_int on a string is a type error");
    check(st, json_as_str(member_cstr(root, "obj"), &slen) == 0, "as_str on an object answers 0");
    check(st, json_as_bool(explicit_null, &bv) == JSON_ERR_TYPE, "as_bool on null is a type error");
    check(st, json_as_int(missing, &iv) == JSON_ERR_TYPE, "as_int on an empty handle is a type error");
    check(st, json_as_bool(member_cstr(member_cstr(root, "obj"), "k"), &bv) == JSON_OK && bv == 1, "as_bool reads true");

    check(st, json_obj_len(member_cstr(root, "arr")) == -1, "obj_len on an array is -1");
    check(st, json_arr_len(member_cstr(root, "obj")) == -1, "arr_len on an object is -1");

    arr = member_cstr(root, "arr");
    check(st, json_arr_len(arr) == 2, "array length is 2");
    check(st, json_as_int(arr.get_idx(0), &iv) == JSON_OK && iv == 10, "get_idx(0) is 10");
    check(st, json_as_int(arr.get_idx(1), &iv) == JSON_OK && iv == 20, "get_idx(1) is 20");
    check(st, arr.get_idx(2).p == 0, "get_idx(len) answers an empty handle");
    check(st, arr.get_idx(-1).p == 0, "get_idx(-1) answers an empty handle");
    check(st, root.get_idx(0).p == 0, "get_idx on an object answers an empty handle");
    check(st, member_cstr(arr, "x").p == 0, "member on an array answers an empty handle");
    check(st, member_cstr(root, null_key).p == 0, "member with a NULL key answers an empty handle");

    {
        int klen = -1;
        char *k0 = json_obj_key_at(root, 0, &klen);
        check(st, k0 != 0 && klen == 1 && k0[0] == 'a', "key_at(0) keeps insertion order");
        klen = -1;
        k0 = json_obj_key_at(root, 1, &klen);
        check(st, k0 != 0 && klen == 1 && k0[0] == 'n', "key_at(1) keeps insertion order");
        check(st, json_obj_key_at(root, 6, &klen) == 0, "key_at out of range answers 0");
        check(st, json_obj_key_at(arr, 0, &klen) == 0, "key_at on an array answers 0");
    }

    check(st, has_cstr(root, "a") == 1, "has finds a present key");
    check(st, has_cstr(root, "zz") == 0, "has rejects a missing key");

    {
        Str k = str_from("name");
        root.set_str(k, "rill", 4);
        k.release();
        check(st, has_cstr(root, "name") == 1, "inserting deep-copies the key");
        check(st, json_obj_len(root) == 7, "the insert grows the object");
    }
    {
        Str nk = str_from_len("a\0b", 3);
        Str q;
        int klen = -1;
        char *kp;
        root.set_str(nk, "v", 1);
        nk.release();
        q = str_from_len("a\0b", 3);
        check(st, root.has(q) == 1, "a key with an embedded NUL is data");
        q.release();
        kp = json_obj_key_at(root, 7, &klen);
        check(st, kp != 0 && klen == 3, "key_at reports the byte length");
    }

    json_free(root);
}

static void array_write_contract(struct Stats *st)
{
    JsonRef root = empty_ref();
    JsonRef items;
    JsonRef num = empty_ref();
    long long iv = 0;
    int rc;

    rc = json_decode("{\"items\":[10,20,null]}", 22, &root);
    check(st, rc == JSON_OK, "array fixture decodes");
    if (rc != JSON_OK) return;
    items = member_cstr(root, "items");

    check(st, items.get_idx(0).p != 0, "get_idx(0) is a handle");
    check(st, json_tag(items.get_idx(2)) == JSON_TAG_NULL, "a null element answers a handle");
    check(st, items.get_idx(3).p == 0, "get_idx(len) is empty");
    check(st, items.get_idx(-1).p == 0, "get_idx(-1) is empty");
    check(st, root.get_idx(0).p == 0, "get_idx on an object is empty");

    rc = json_decode("7", 1, &num);
    check(st, rc == JSON_OK, "scalar fixture decodes");
    items.push(num);
    json_release(num);
    check(st, json_arr_len(items) == 4, "push appends");
    check(st, json_as_int(items.get_idx(3), &iv) == JSON_OK && iv == 7, "the pushed value is readable");

    check(st, items.set_idx(3, items.get_idx(0)) == JSON_OK, "set_idx overwrites in range");
    check(st, json_as_int(items.get_idx(3), &iv) == JSON_OK && iv == 10, "the overwrite is visible");
    check(st, items.set_idx(4, items.get_idx(0)) == JSON_ERR_RANGE, "set_idx(len) is a range error");
    check(st, items.set_idx(-1, items.get_idx(0)) == JSON_ERR_RANGE, "set_idx(-1) is a range error");
    check(st, json_arr_len(items) == 4, "a rejected set_idx does not grow the array");
    check(st, root.set_idx(0, items.get_idx(0)) == JSON_ERR_RANGE, "set_idx on an object is a range error");

    json_free(root);
}

static void write_contract(struct Stats *st)
{
    JsonRef root = empty_ref();
    Str ki = str_from("i");
    Str kd = str_from("d");
    Str kb = str_from("b");
    Str kn = str_from("n");
    Str ks = str_from("s");
    Str kg = str_from("gone");
    long long iv = 0;
    double dv = 0.0;
    int bv = 0;
    int slen = -1;
    char *sp;
    int rc;

    rc = json_decode("{\"gone\":1}", 10, &root);
    check(st, rc == JSON_OK, "write fixture decodes");
    if (rc != JSON_OK) return;

    root.set_int(ki, -42);
    root.set_double(kd, 2.5);
    root.set_bool(kb, 1);
    root.set_null(kn);
    root.set_str(ks, "hi", 2);
    check(st, json_as_int(member_cstr(root, "i"), &iv) == JSON_OK && iv == -42, "set_int writes an int64");
    check(st, json_as_double(member_cstr(root, "d"), &dv) == JSON_OK && dv == 2.5, "set_double writes a double");
    check(st, json_as_bool(member_cstr(root, "b"), &bv) == JSON_OK && bv == 1, "set_bool writes true");
    check(st, json_tag(member_cstr(root, "n")) == JSON_TAG_NULL, "set_null writes null");
    sp = json_as_str(member_cstr(root, "s"), &slen);
    check(st, sp != 0 && slen == 2 && sp[0] == 'h', "set_str writes a string");
    check(st, json_obj_len(root) == 6, "writes append six keys in total");

    root.set_int(ki, 7);
    check(st, json_obj_len(root) == 6, "overwriting a key keeps the object size");
    check(st, json_as_int(member_cstr(root, "i"), &iv) == JSON_OK && iv == 7, "overwriting replaces the value");
    {
        int klen = -1;
        char *k0 = json_obj_key_at(root, 0, &klen);
        check(st, k0 != 0 && klen == 4, "overwriting keeps the key position");
    }

    root.remove(kg);
    check(st, has_cstr(root, "gone") == 0, "remove drops the key");
    check(st, json_obj_len(root) == 5, "remove shrinks the object");
    check(st, has_cstr(root, "i") == 1, "remove keeps its neighbours");

    ki.release();
    kd.release();
    kb.release();
    kn.release();
    ks.release();
    kg.release();
    json_free(root);
}

static void subscript_contract(struct Stats *st)
{
    JsonRef root = empty_ref();
    JsonRef server;
    JsonRef host;
    char *text = "{\"server\":{\"host\":\"db.local\"}}";
    char *out;
    int slen = -1;
    char *sp;
    int rc;

    rc = json_decode(text, (int)strlen(text), &root);
    check(st, rc == JSON_OK, "subscript fixture decodes");
    if (rc != JSON_OK) return;

    server = root["server"];
    check(st, json_tag(server) == JSON_TAG_OBJ, "v[\"k\"] reads a member");
    host = server["host"];
    sp = json_as_str(host, &slen);
    check(st, sp != 0 && slen == 8, "a local handle carries the next subscript");

    root["alias"] = server;
    check(st, has_cstr(root, "alias") == 1, "v[\"k\"] = ref writes a member");
    check(st, root.p->refs == 1, "a shared write does not change the root count");

    out = json_encode(root);
    check(st, out != 0 && strstr(out, "\"alias\":{\"host\":\"db.local\"}") != 0,
          "a shared subtree is written once per occurrence");
    free(out);
    json_free(root);
}

/* CT v0.62.0 lifted the temporary-receiver limits that JSON-1 / JSON-2
 * recorded. These assertions pin the three shapes that used to fail:
 * three-level subscripts (declaration and assignment), a method on a
 * subscript result, and a chain of method results. */
static JsonRef chain_pick(JsonRef doc)
{
    return doc["a"]["b"]["c"];
}

static void chain_contract(struct Stats *st)
{
    JsonRef root = empty_ref();
    JsonRef c;
    JsonRef b;
    Str k = str_from("host");
    char *text = "{\"a\":{\"b\":{\"c\":1}},\"server\":{\"host\":\"h\"}}";
    int present;
    long long iv = 0;
    int rc;

    rc = json_decode(text, (int)strlen(text), &root);
    check(st, rc == JSON_OK, "chain fixture decodes");
    if (rc != JSON_OK) {
        k.release();
        return;
    }

    c = root["a"]["b"]["c"];
    check(st, json_as_int(c, &iv) == JSON_OK && iv == 1, "3-level chain decl init");

    c = empty_ref();
    c = root["a"]["b"]["c"];
    check(st, json_as_int(c, &iv) == JSON_OK && iv == 1, "3-level chain assign rhs");

    c = chain_pick(root);
    check(st, json_as_int(c, &iv) == JSON_OK && iv == 1, "3-level chain return pos");

    b = root.get("a").get("b");
    check(st, json_tag(b) == JSON_TAG_OBJ, "method-result chain receiver");

    present = root["server"].has(k);
    check(st, present == 1, "method on subscript result");

    b = root["a"].get("b");
    check(st, json_tag(b) == JSON_TAG_OBJ, "method on subscript chain");

    k.release();
    json_free(root);
}

/* R-B-04 / R-B-07: a value with an embedded U+0000 must survive
 * decode -> encode -> decode with the same byte count and bytes. */
static void nul_value_contract(struct Stats *st)
{
    JsonRef root = empty_ref();
    JsonRef back = empty_ref();
    JsonRef s;
    char *text = "{\"s\":\"a\\u0000b\"}";
    char *enc;
    char *sp;
    int slen = -1;
    int rc;

    rc = json_decode(text, (int)strlen(text), &root);
    check(st, rc == JSON_OK, "NUL fixture decodes");
    if (rc != JSON_OK) return;
    s = member_cstr(root, "s");
    sp = json_as_str(s, &slen);
    check(st, sp != 0 && slen == 3 && sp[1] == 0, "a NUL value keeps three bytes");

    enc = json_encode(root);
    check(st, enc != 0, "a NUL value encodes");
    if (enc != 0) {
        rc = json_decode(enc, (int)strlen(enc), &back);
        check(st, rc == JSON_OK, "the NUL encoding parses");
        sp = json_as_str(member_cstr(back, "s"), &slen);
        check(st, sp != 0 && slen == 3 && sp[1] == 0 && sp[2] == 'b',
              "a NUL value round-trips");
        json_free(back);
    }
    free(enc);
    json_free(root);
}

static void cycle_contract(struct Stats *st)
{
    JsonRef root = empty_ref();
    Str k = str_from("self");
    char *out;
    int rc;

    rc = json_decode("{}", 2, &root);
    check(st, rc == JSON_OK, "cycle fixture decodes");
    if (rc != JSON_OK) return;

    root["self"] = root;
    out = json_encode(root);
    check(st, out == 0, "encoding a cycle answers 0");
    check(st, json_last_error() == JSON_ERR_CYCLE, "a cycle reports JSON_ERR_CYCLE");
    free(out);

    root.remove(k);
    k.release();
    check(st, json_obj_len(root) == 0, "removing the back-edge breaks the cycle");
    json_free(root);
}

static void numeric_edges(struct Stats *st)
{
    JsonRef root = empty_ref();
    char *text = "{\"max\":9223372036854775807,\"min\":-9223372036854775808,\"over\":9223372036854775808}";
    long long iv = 0;
    double dv = 0.0;
    int rc;

    rc = json_decode(text, (int)strlen(text), &root);
    if (rc != JSON_OK) {
        check(st, 0, "numeric fixture decodes");
        return;
    }
    check(st, json_tag(member_cstr(root, "max")) == JSON_TAG_NUM, "max is a number");
    check(st, json_as_int(member_cstr(root, "max"), &iv) == JSON_OK && iv == 9223372036854775807LL, "int64 max is exact");
    check(st, json_as_int(member_cstr(root, "over"), &iv) == JSON_ERR_RANGE, "int64 max + 1 is a range error");
    check(st, json_as_double(member_cstr(root, "min"), &dv) == JSON_OK, "int64 min is readable as a double");
    json_free(root);
}

static void error_contract(struct Stats *st)
{
    JsonRef root = empty_ref();
    char *deep64;
    char *deep65;
    int rc;

    expect_err(st, "empty input is EOF", "", JSON_ERR_EOF);
    expect_err(st, "whitespace only is EOF", "  ", JSON_ERR_EOF);
    expect_err(st, "second root is trailing", "{} {}", JSON_ERR_TRAILING);
    expect_err(st, "unterminated object is EOF", "{", JSON_ERR_EOF);
    expect_err(st, "unterminated string is EOF", "\"abc", JSON_ERR_EOF);
    expect_err(st, "missing value is syntax", "{\"a\":}", JSON_ERR_SYNTAX);
    expect_err(st, "trailing comma in array is syntax", "[1,]", JSON_ERR_SYNTAX);
    expect_err(st, "missing colon is syntax", "{\"a\" 1}", JSON_ERR_SYNTAX);
    expect_err(st, "leading zero is a number error", "01", JSON_ERR_NUMBER);
    expect_err(st, "bare minus is a number error", "-", JSON_ERR_NUMBER);
    expect_err(st, "dot without digits is a number error", "1.", JSON_ERR_NUMBER);
    expect_err(st, "exponent without digits is a number error", "1e", JSON_ERR_NUMBER);
    expect_err(st, "plus prefix is syntax", "+1", JSON_ERR_SYNTAX);
    expect_err(st, "unknown escape is an escape error", "\"\\q\"", JSON_ERR_ESCAPE);
    expect_err(st, "bad hex is a unicode error", "\"\\u00zz\"", JSON_ERR_UNICODE);
    expect_err(st, "lone high surrogate is a surrogate error", "\"\\ud800\"", JSON_ERR_SURROGATE);
    expect_err(st, "control byte in string is a string error", "\"a\nb\"", JSON_ERR_STRING);

    rc = json_decode(0, 0, &root);
    check(st, rc == JSON_ERR_EOF && root.p == 0, "NULL text is EOF");
    json_free(root);

    deep64 = nest(64);
    deep65 = nest(65);
    root = empty_ref();
    rc = json_decode(deep64, (int)strlen(deep64), &root);
    check(st, rc == JSON_OK, "64 levels decode");
    json_free(root);
    root = empty_ref();
    rc = json_decode(deep65, (int)strlen(deep65), &root);
    check(st, rc == JSON_ERR_DEPTH && root.p == 0, "65 levels stop at depth 64");
    json_free(root);
    free(deep64);
    free(deep65);
}

int main(void)
{
    struct Stats st;
    char *deep64 = nest(64);

    st.total = 0;
    st.failed = 0;

    check(&st, json_encode(empty_ref()) == 0, "encode of an empty handle answers 0");
    check(&st, json_tag(empty_ref()) == -1, "tag of an empty handle is -1");

    roundtrip(&st, "round trip: empty object", "{}", "{}");
    roundtrip(&st, "round trip: empty array", "[]", "[]");
    roundtrip(&st, "round trip: scalars",
              "{\"t\":true,\"f\":false,\"n\":null}", "{\"t\":true,\"f\":false,\"n\":null}");
    roundtrip(&st, "round trip: nested",
              "{\"server\":{\"host\":\"localhost\",\"port\":8080},\"tags\":[\"a\",\"b\"],\"ok\":false}",
              "{\"server\":{\"host\":\"localhost\",\"port\":8080},\"tags\":[\"a\",\"b\"],\"ok\":false}");
    roundtrip(&st, "round trip: nested arrays", "[[1,2],[3,4],[]]", "[[1,2],[3,4],[]]");
    roundtrip(&st, "round trip: whitespace normalised", " { \"a\" : [ 1 , 2 ] } ", "{\"a\":[1,2]}");
    roundtrip(&st, "round trip: escapes",
              "{\"s\":\"a\\\"b\\\\c\\nd\\te\"}", "{\"s\":\"a\\\"b\\\\c\\nd\\te\"}");
    roundtrip(&st, "round trip: unicode escapes",
              "{\"u\":\"\\u0041\\u00e9\\u20ac\\ud83d\\ude00\"}", "{\"u\":\"Aé€😀\"}");
    roundtrip(&st, "round trip: numbers keep source text",
              "{\"e\":1e3,\"f\":0.10,\"big\":9007199254740993}",
              "{\"e\":1e3,\"f\":0.10,\"big\":9007199254740993}");
    roundtrip(&st, "round trip: duplicate key last wins", "{\"a\":1,\"a\":2}", "{\"a\":2}");
    roundtrip(&st, "round trip: empty string", "{\"s\":\"\"}", "{\"s\":\"\"}");
    roundtrip(&st, "round trip: escaped key", "{\"\\u0061\":1}", "{\"a\":1}");
    roundtrip(&st, "round trip: 64 levels", deep64, deep64);

    access_contract(&st);
    lifecycle_contract(&st);
    array_write_contract(&st);
    write_contract(&st);
    nul_value_contract(&st);
    subscript_contract(&st);
    chain_contract(&st);
    cycle_contract(&st);
    numeric_edges(&st);
    error_contract(&st);
    free(deep64);

    if (st.failed == 0) {
        printf("all checks passed\n");
        return 0;
    }
    printf("%d of %d checks failed\n", st.failed, st.total);
    return 1;
}
