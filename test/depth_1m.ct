/*
 * R-A-10 fixture: a 10^6-deep array must stop at the hard depth cap
 * (JSON_ERR_DEPTH) without crashing the C stack.
 *
 *   CT_STD_DIR=/Users/samxx/trae-ws/ct-lang/lib/std \
 *     ct build test/depth_1m.ct -I src -o /tmp/depth1m && /tmp/depth1m
 *
 * Exit 0 only when the decoder answers JSON_ERR_DEPTH and leaves the root empty.
 */
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

import json;

int main(void)
{
    int n = 1000000;
    int i;
    int rc;
    char *text = malloc((size_t)n * 2 + 1);
    JsonRef r = { .p = 0 };

    if (text == 0) return 1;
    for (i = 0; i < n; i = i + 1) text[i] = '[';
    for (i = 0; i < n; i = i + 1) text[n + i] = ']';
    text[n * 2] = 0;

    rc = json_decode(text, n * 2, &r);
    printf("depth1m: rc=%d empty=%d\n", rc, r.p == 0);
    json_free(r);
    free(text);
    return (rc == JSON_ERR_DEPTH && r.p == 0) ? 0 : 1;
}
