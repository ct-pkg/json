# ct-pkg/json - a reference-counted JSON tree for CT.
# Toolchain: the L2 `ct` command. `ctc` (L0) cannot parse generic declarations
# (`Map<...>` / `Vec<...>`), so it is not a supported build path.
# Consumed with `ct get`: the store is ~/.ct/pkg/<publisher>/<name>/<version>
# and the consumer gets a ct.lock (no vendor/ since v0.62.0). Import `json;`.
# Consumer builds currently break in ctc L0 on generic declarations (JSON-15).
name = json
publisher = ct
ns-root = src
version = 0.6.0
licence = MIT
namespace = json
requires = ct >= 0.53.0
