/*
 * json.h.ct -- ct-json 0.1.0 (CT v0.52.0 rewrite).
 *
 * Shards 1-2 of the in-progress rewrite: the tree is a reference-counted
 * `JsonNode`, both containers release their elements through an explicit
 * `impl Drop` loop, and object keys are `Str` (deep-copied on insert, owned by
 * the container).
 *
 * Model (docs/spec/ct-json-0.1.0.md §二):
 *   JsonRef     8-byte value handle over a `JsonNode`; copying the handle does
 *               not change the count, `json_retain` / `json_release` do.
 *   JsonNode    tag + refs + num_kind + a named `JsonValue` union.
 *   JsonObj     insertion-ordered key array + value array; owns key copies.
 *   JsonArr     element array; owns one reference per element.
 *
 * Numbers are two-track (ADR-0004): a parsed number keeps its source text in
 * `v.lit` and encodes back verbatim; a program-written number is `num_kind` 1
 * (int64) or 2 (double).
 */
#include <stdlib.h>
#include <string.h>
#include <stdio.h>

/* The six JSON kinds. Numbers are one kind; `num_kind` tells the tracks
   apart. `json_tag` answers -1 for an empty handle, so a missing member is
   never confused with an explicit JSON null (tag 0). */
pub enum JsonTag {
    JSON_TAG_NULL = 0,
    JSON_TAG_BOOL = 1,
    JSON_TAG_NUM = 2,
    JSON_TAG_STR = 3,
    JSON_TAG_OBJ = 4,
    JSON_TAG_ARR = 5
}

/* Negative codes: 0 is success, every failure is < 0. */
pub enum JsonCode {
    JSON_OK = 0,
    JSON_ERR_EOF = -1,
    JSON_ERR_SYNTAX = -2,
    JSON_ERR_TRAILING = -3,
    JSON_ERR_STRING = -4,
    JSON_ERR_ESCAPE = -5,
    JSON_ERR_UNICODE = -6,
    JSON_ERR_SURROGATE = -7,
    JSON_ERR_NUMBER = -8,
    JSON_ERR_DEPTH = -9,
    JSON_ERR_MEMORY = -10,
    JSON_ERR_TYPE = -11,
    JSON_ERR_RANGE = -12,
    JSON_ERR_CYCLE = -13,
    JSON_ERR_UTF8 = -14
}

/* The uniform element type of both containers. `p == 0` is the empty handle:
   "no such value", distinct from a present JSON null. */
pub struct JsonRef {
    struct JsonNode *p;
}

/* Named on purpose: `union { ... } v;` is a hard error in CT
   (`an anonymous record member cannot have a name`). */
pub union JsonValue {
    int b;
    long long i;
    double d;
    Str s;       /* string value, length-carrying */
    Str lit;     /* source text of a parsed number */
    struct JsonObj *obj;
    struct JsonArr *arr;
}

pub struct JsonNode {
    int tag;       /* JsonTag */
    int refs;      /* reference count, starts at 1 */
    int num_kind;  /* 0 = source text, 1 = int64, 2 = double */
    JsonValue v;
}

pub struct JsonObj {
    int len;
    int cap;
    Str *keys;              /* container-owned copies, length-carrying */
    JsonRef *vals;
    Map<Str, int> *index;   /* key -> slot */
} use Drop;

pub struct JsonArr {
    int len;
    int cap;
    JsonRef *items;
} use Drop;

/* ------------------------------------------------------------- lifetime */

pub void json_retain(JsonRef v);
pub void json_release(JsonRef v);
pub void json_free(JsonRef v);

/* Last error recorded by `json_decode` or `json_encode` on this thread; reset
   to JSON_OK at the start of each call. */
pub int json_last_error(void);

/* R-C-01: position of the most recent parse failure. `json_error_offset` is a
   0-based byte offset; line and column are 1-based and count bytes. A
   successful decode resets all three to 0. */
pub int json_error_offset(void);
pub int json_error_line(void);
pub int json_error_column(void);

/* R-C-03: a non-empty static description for a known code, or a fixed
   non-empty string for an unknown one. The caller must not free it. */
pub char *json_message(int code);

/* The container drop order is fixed: release `[0, len)` elements, then free
   the element/key arrays, then the container itself. Slots in `[len, cap)`
   were never constructed and are not touched. */
impl Drop for JsonObj {
    void drop()
    {
        int i;
        for (i = 0; i < self->len; i = i + 1) {
            json_release(self->vals[i]);
            free(self->keys[i].data);
            self->keys[i].data = 0;
            self->keys[i].len = -1;
        }
        free(self->keys);
        free(self->vals);
        if (self->index != 0) {
            /* `Map::release` treats `h == 0` as "already released"; j1_obj_new
               hands the header allocated by `Map<Str,int> z = {}` to the
               object, so `h` is non-NULL for every live object. */
            if (self->index->h != 0) self->index->release();
            free(self->index);
        }
        self->len = 0;
        self->cap = 0;
        self->keys = 0;
        self->vals = 0;
        self->index = 0;
    }
}

impl Drop for JsonArr {
    void drop()
    {
        int i;
        for (i = 0; i < self->len; i = i + 1) json_release(self->items[i]);
        free(self->items);
        self->len = 0;
        self->cap = 0;
        self->items = 0;
    }
}

/* ------------------------------------------------------------- decoding */

/* Parse `len` bytes of `text`. On JSON_OK `out->p` is the root and the caller
   owns exactly one reference; on failure a negative code is returned and
   `out` is untouched. `text` is not modified. Nesting depth limit: 64. */
pub int json_decode(char *text, int len, JsonRef *out);

/* R-A-08: same parse, plus strict UTF-8 validation of string values and keys.
   Invalid UTF-8 answers JSON_ERR_UTF8; the lenient entry keeps passing bytes
   above 0x7F through unchanged. */
pub int json_decode_strict(char *text, int len, JsonRef *out);

/* Serialise into a fresh NUL-terminated buffer the caller frees. Objects keep
   insertion order, parsed numbers keep their source text, shared subtrees are
   written once per occurrence. Returns 0 on an empty handle or a cycle (the
   cycle code is then visible through `json_last_error`). */
pub char *json_encode(JsonRef root);

/* ------------------------------------------------------------- access */

pub int json_tag(JsonRef v);
pub int json_is_null(JsonRef v);

/* Explicit conversions; there is no implicit one. A tag mismatch answers
   JSON_ERR_TYPE and leaves `out` untouched; an int64 conversion that does not
   fit answers JSON_ERR_RANGE. */
pub int json_as_bool(JsonRef v, int *out);
pub int json_as_int(JsonRef v, long long *out);
pub int json_as_double(JsonRef v, double *out);

/* Borrowed pointer into the node's string; the byte count goes to `len` when
   `len` is not 0. The buffer is not NUL-terminated as a contract and may
   contain U+0000. */
pub char *json_as_str(JsonRef v, int *len);

/* -1 on a tag mismatch or an empty handle. */
pub int json_obj_len(JsonRef v);
pub int json_arr_len(JsonRef v);

/* Borrowed member handle; empty when `v` is not an object or the key is
   absent. A present JSON null answers a non-empty handle. The key is `Str`
   only: a `char *` key does not compile, and the container deep-copies what it
   keeps. */
pub JsonRef json_member(JsonRef v, Str key);

/* Borrowed key bytes at `i` in insertion order, with the byte count written to
   `len`; 0 out of range. */
pub char *json_obj_key_at(JsonRef v, int i, int *len);

/* R-D-09: write `value` at the dot-separated object path `path` under `root`.
   Missing intermediate objects are created. A root or intermediate that is not
   an object answers JSON_ERR_TYPE without touching the tree; an empty path or
   an empty path segment answers JSON_ERR_RANGE; an empty value handle is a
   type error. The container retains its own reference on `value`, so the
   caller keeps and releases its handle (same contract as `v.set`). */
pub int json_set(JsonRef root, Str path, JsonRef value);

/* Members of `JsonRef` (all `pub`, so the subscript protocol also works across
   units):
     get(char *key)             v["key"]            borrowed handle
     set(char *key, JsonRef v)  v["key"] = v        shared write
     has(Str key)               presence, NUL-safe
     get_idx(int i)             array read (0.1.0 stand-in for v[i])
     set_idx(int i, JsonRef v)  overwrite only, JSON_ERR_RANGE when out of range
     push(JsonRef v)            append
     set_int/set_double/set_bool/set_null/set_str/remove   Str keys only */

/* ------------------------------------------------------------- internals */

#define J1_DEPTH_LIMIT 64
#define J1_ENC_DEPTH_LIMIT 256

static int j1_last_error = 0;
static int j1_err_pos = 0;
static int j1_err_line = 0;
static int j1_err_col = 0;

struct J1Parser {
    char *src;
    int len;
    int pos;
    int depth;
    int err;
    int strict;
}

struct J1Buf {
    char *p;
    int len;
    int cap;
    int bad;
}

/* A failed allocation aborts, like the built-in `Vec` header: every node is
   reachable, so there is no partial-failure branch to thread through. */
static void *j1_alloc(size_t n)
{
    void *p = malloc(n);
    if (p == 0) abort();
    return p;
}

static void j1_str_drop(Str *s)
{
    free(s->data);
    s->data = 0;
    s->len = -1;
}

static JsonRef j1_empty(void)
{
    JsonRef r;
    r.p = 0;
    return r;
}

static JsonRef j1_node_make(int tag)
{
    JsonNode *n = j1_alloc(sizeof(struct JsonNode));
    JsonRef r;
    memset(n, 0, sizeof(struct JsonNode));
    n->tag = tag;
    n->refs = 1;
    n->num_kind = 0;
    r.p = n;
    return r;
}

static void j1_node_destroy(JsonNode *n)
{
    if (n == 0) return;
    if (n->tag == JSON_TAG_STR) {
        free(n->v.s.data);
        n->v.s.data = 0;
        n->v.s.len = -1;
    } else if (n->tag == JSON_TAG_NUM) {
        if (n->num_kind == 0) {
            free(n->v.lit.data);
            n->v.lit.data = 0;
            n->v.lit.len = -1;
        }
    } else if (n->tag == JSON_TAG_OBJ) {
        JsonObj *o = n->v.obj;
        if (o != 0) delete o;
    } else if (n->tag == JSON_TAG_ARR) {
        JsonArr *a = n->v.arr;
        if (a != 0) delete a;
    }
    free(n);
}

pub void json_retain(JsonRef v)
{
    if (v.p == 0) return;
    v.p->refs = v.p->refs + 1;
}

pub void json_release(JsonRef v)
{
    if (v.p == 0) return;
    v.p->refs = v.p->refs - 1;
    if (v.p->refs > 0) return;
    j1_node_destroy(v.p);
}

pub void json_free(JsonRef v)
{
    json_release(v);
}

pub int json_last_error(void)
{
    return j1_last_error;
}

pub int json_error_offset(void)
{
    return j1_err_pos;
}

pub int json_error_line(void)
{
    return j1_err_line;
}

pub int json_error_column(void)
{
    return j1_err_col;
}

pub char *json_message(int code)
{
    if (code == JSON_OK) return "ok";
    if (code == JSON_ERR_EOF) return "unexpected end of input";
    if (code == JSON_ERR_SYNTAX) return "syntax error";
    if (code == JSON_ERR_TRAILING) return "trailing data after the root value";
    if (code == JSON_ERR_STRING) return "invalid string";
    if (code == JSON_ERR_ESCAPE) return "unknown escape";
    if (code == JSON_ERR_UNICODE) return "invalid unicode escape";
    if (code == JSON_ERR_SURROGATE) return "lone surrogate";
    if (code == JSON_ERR_NUMBER) return "invalid number";
    if (code == JSON_ERR_DEPTH) return "nesting too deep";
    if (code == JSON_ERR_MEMORY) return "out of memory";
    if (code == JSON_ERR_TYPE) return "type mismatch";
    if (code == JSON_ERR_RANGE) return "out of range";
    if (code == JSON_ERR_CYCLE) return "cycle in the tree";
    if (code == JSON_ERR_UTF8) return "invalid UTF-8";
    return "unknown error code";
}

static JsonObj *j1_obj_new(void)
{
    Map<Str, int> z = {};
    JsonObj *o = j1_alloc(sizeof(struct JsonObj));
    o->len = 0;
    o->cap = 0;
    o->keys = 0;
    o->vals = 0;
    o->index = j1_alloc(sizeof(z));
    o->index->h = z.h;
    return o;
}

static JsonArr *j1_arr_new(void)
{
    JsonArr *a = j1_alloc(sizeof(struct JsonArr));
    a->len = 0;
    a->cap = 0;
    a->items = 0;
    return a;
}

/* Creates one empty object node; the caller owns the returned reference. */
static JsonRef j1_new_obj_ref(void)
{
    JsonRef r = j1_node_make(JSON_TAG_OBJ);
    r.p->v.obj = j1_obj_new();
    return r;
}

static int j1_obj_grow(JsonObj *o)
{
    int nc = o->cap == 0 ? 4 : o->cap * 2;
    Str *nk = realloc(o->keys, (size_t)nc * sizeof(struct Str));
    JsonRef *nv;
    if (nk == 0) return 0;
    o->keys = nk;
    nv = realloc(o->vals, (size_t)nc * sizeof(struct JsonRef));
    if (nv == 0) return 0;
    o->vals = nv;
    o->cap = nc;
    return 1;
}

/* Takes one reference on `val`; the key is deep-copied, so the caller keeps
 * ownership of its `Str` and releases it. A repeated key keeps the first
 * position (insertion order) and replaces the value. */
static int j1_obj_put(JsonObj *o, Str key, JsonRef val)
{
    int *slot;
    Str ck;
    if (key.len < 0) return 0;
    slot = o->index->get(key);
    if (slot != 0) {
        json_release(o->vals[*slot]);
        o->vals[*slot] = val;
        return 1;
    }
    ck = str_from_len(key.data, key.len);
    if (ck.len < 0) return 0;
    if (o->len == o->cap && !j1_obj_grow(o)) {
        free(ck.data);
        return 0;
    }
    if (!o->index->put(ck, o->len)) {
        free(ck.data);
        return 0;
    }
    o->keys[o->len] = ck;
    o->vals[o->len] = val;
    o->len = o->len + 1;
    return 1;
}

static int j1_arr_grow(JsonArr *a)
{
    int nc = a->cap == 0 ? 4 : a->cap * 2;
    JsonRef *nv = realloc(a->items, (size_t)nc * sizeof(struct JsonRef));
    if (nv == 0) return 0;
    a->items = nv;
    a->cap = nc;
    return 1;
}

/* Takes ownership of one reference on `val`. */
static int j1_arr_push(JsonArr *a, JsonRef val)
{
    if (a->len == a->cap && !j1_arr_grow(a)) return 0;
    a->items[a->len] = val;
    a->len = a->len + 1;
    return 1;
}

/* Stores one node under `key`, taking ownership of the reference on `value`.
 * Used by the `set_*` methods, so they cannot disagree about lifetime. */
static void j1_obj_store(JsonRef owner, Str key, JsonRef value)
{
    JsonObj *o;
    if (owner.p == 0 || owner.p->tag != JSON_TAG_OBJ || key.len < 0) {
        json_release(value);
        return;
    }
    o = owner.p->v.obj;
    if (o == 0) {
        json_release(value);
        return;
    }
    if (!j1_obj_put(o, key, value)) json_release(value);
}

static JsonRef j1_num_int(long long v)
{
    JsonRef r = j1_node_make(JSON_TAG_NUM);
    r.p->num_kind = 1;
    r.p->v.i = v;
    return r;
}

static JsonRef j1_num_double(double v)
{
    JsonRef r = j1_node_make(JSON_TAG_NUM);
    r.p->num_kind = 2;
    r.p->v.d = v;
    return r;
}

static void j1_obj_reindex(JsonObj *o)
{
    int i;
    o->index->clear();
    for (i = 0; i < o->len; i = i + 1) o->index->put(o->keys[i], i);
}

/* Records the byte offset and the 1-based line/column of the first failure.
   Column counts bytes, matching R-C-01. */
static void j1_place(struct J1Parser *p, int pos)
{
    int i;
    j1_err_pos = pos;
    j1_err_line = 1;
    j1_err_col = 1;
    if (p->src == 0) return;
    for (i = 0; i < pos && i < p->len; i = i + 1) {
        if (p->src[i] == '\n') {
            j1_err_line = j1_err_line + 1;
            j1_err_col = 1;
        } else {
            j1_err_col = j1_err_col + 1;
        }
    }
}

static void j1_fail(struct J1Parser *p, int code)
{
    if (p->err == 0) {
        p->err = code;
        j1_place(p, p->pos);
    }
}

static void j1_ws(struct J1Parser *p)
{
    while (p->pos < p->len) {
        char c = p->src[p->pos];
        if (c == ' ' || c == '\t' || c == '\n' || c == '\r')
            p->pos = p->pos + 1;
        else
            break;
    }
}

static int j1_put_utf8(char *out, int n, int cp)
{
    if (cp < 0x80) {
        out[n] = cp;
        return n + 1;
    }
    if (cp < 0x800) {
        out[n] = 0xC0 | (cp >> 6);
        out[n + 1] = 0x80 | (cp & 0x3F);
        return n + 2;
    }
    if (cp < 0x10000) {
        out[n] = 0xE0 | (cp >> 12);
        out[n + 1] = 0x80 | ((cp >> 6) & 0x3F);
        out[n + 2] = 0x80 | (cp & 0x3F);
        return n + 3;
    }
    out[n] = 0xF0 | (cp >> 18);
    out[n + 1] = 0x80 | ((cp >> 12) & 0x3F);
    out[n + 2] = 0x80 | ((cp >> 6) & 0x3F);
    out[n + 3] = 0x80 | (cp & 0x3F);
    return n + 4;
}

static int j1_hex_digit(int c)
{
    if (c >= '0' && c <= '9') return c - '0';
    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
    if (c >= 'A' && c <= 'F') return c - 'A' + 10;
    return -1;
}

static int j1_hex4(struct J1Parser *p, int *out)
{
    int i;
    int v = 0;
    for (i = 0; i < 4; i = i + 1) {
        int d;
        if (p->pos >= p->len) {
            j1_fail(p, JSON_ERR_EOF);
            return 0;
        }
        d = j1_hex_digit(p->src[p->pos]);
        if (d < 0) {
            j1_fail(p, JSON_ERR_UNICODE);
            return 0;
        }
        v = v * 16 + d;
        p->pos = p->pos + 1;
    }
    *out = v;
    return 1;
}

/* Decode one escape (the backslash is already consumed). Writes 1-4 bytes and
   answers the new length through `n`; 0 on failure with the code recorded. */
static int j1_escape(struct J1Parser *p, char *out, int *n)
{
    int c;
    if (p->pos >= p->len) {
        j1_fail(p, JSON_ERR_EOF);
        return 0;
    }
    c = p->src[p->pos];
    if (c < 0) c = c + 256;
    p->pos = p->pos + 1;
    if (c == '"' || c == '\\' || c == '/') {
        out[*n] = c;
        *n = *n + 1;
        return 1;
    }
    if (c == 'b') { out[*n] = 8;  *n = *n + 1; return 1; }
    if (c == 'f') { out[*n] = 12; *n = *n + 1; return 1; }
    if (c == 'n') { out[*n] = 10; *n = *n + 1; return 1; }
    if (c == 'r') { out[*n] = 13; *n = *n + 1; return 1; }
    if (c == 't') { out[*n] = 9;  *n = *n + 1; return 1; }
    if (c == 'u') {
        int cp;
        if (!j1_hex4(p, &cp)) return 0;
        if (cp >= 0xD800 && cp <= 0xDBFF) {
            int lo;
            if (p->pos + 1 >= p->len || p->src[p->pos] != '\\' || p->src[p->pos + 1] != 'u') {
                j1_fail(p, JSON_ERR_SURROGATE);
                return 0;
            }
            p->pos = p->pos + 2;
            if (!j1_hex4(p, &lo)) return 0;
            if (lo < 0xDC00 || lo > 0xDFFF) {
                j1_fail(p, JSON_ERR_SURROGATE);
                return 0;
            }
            cp = 0x10000 + ((cp - 0xD800) << 10) + (lo - 0xDC00);
        } else if (cp >= 0xDC00 && cp <= 0xDFFF) {
            j1_fail(p, JSON_ERR_SURROGATE);
            return 0;
        }
        *n = j1_put_utf8(out, *n, cp);
        return 1;
    }
    j1_fail(p, JSON_ERR_ESCAPE);
    return 0;
}

/* Raw bytes >= 0x80 are copied through: UTF-8 is not validated. `defer` is
   rejected inside a `.h.ct` unit, so the caller frees on failure. */
static int j1_string_into(struct J1Parser *p, char *out, int *outn)
{
    int n = 0;
    p->pos = p->pos + 1;
    while (1) {
        int c;
        if (p->pos >= p->len) {
            j1_fail(p, JSON_ERR_EOF);
            return 0;
        }
        c = p->src[p->pos];
        if (c < 0) c = c + 256;
        if (c == '"') {
            p->pos = p->pos + 1;
            out[n] = 0;
            *outn = n;
            return 1;
        }
        if (c == '\\') {
            p->pos = p->pos + 1;
            if (!j1_escape(p, out, &n)) return 0;
            continue;
        }
        if (c < 0x20) {
            j1_fail(p, JSON_ERR_STRING);
            return 0;
        }
        out[n] = c;
        n = n + 1;
        p->pos = p->pos + 1;
    }
}

/* Strict-mode UTF-8 validation of one decoded string value or key. Rejects
   overlong forms, UTF-8 encoded surrogates, values above U+10FFFF and lone
   continuation bytes. */
static int j1_utf8_valid(char *s, int n)
{
    int i = 0;
    while (i < n) {
        int c = s[i];
        int need;
        int cp;
        int k;
        if (c < 0) c = c + 256;
        if (c < 0x80) {
            i = i + 1;
            continue;
        }
        if (c >= 0xC2 && c <= 0xDF) {
            need = 1;
            cp = c & 0x1F;
        } else if (c >= 0xE0 && c <= 0xEF) {
            need = 2;
            cp = c & 0x0F;
        } else if (c >= 0xF0 && c <= 0xF4) {
            need = 3;
            cp = c & 0x07;
        } else {
            return 0;
        }
        if (i + need >= n) return 0;
        for (k = 1; k <= need; k = k + 1) {
            int b = s[i + k];
            if (b < 0) b = b + 256;
            if ((b & 0xC0) != 0x80) return 0;
            cp = (cp << 6) | (b & 0x3F);
        }
        if (need == 2 && (cp < 0x800 || (cp >= 0xD800 && cp <= 0xDFFF))) return 0;
        if (need == 3 && (cp < 0x10000 || cp > 0x10FFFF)) return 0;
        i = i + need + 1;
    }
    return 1;
}

static int j1_string(struct J1Parser *p, Str *out)
{
    char *buf;
    int n = 0;
    Str s;
    if (p->pos >= p->len || p->src[p->pos] != '"') {
        j1_fail(p, JSON_ERR_SYNTAX);
        return 0;
    }
    buf = j1_alloc((size_t)(p->len - p->pos) + 1);
    if (!j1_string_into(p, buf, &n)) {
        free(buf);
        return 0;
    }
    s = str_from_len(buf, n);
    free(buf);
    if (s.len < 0) {
        j1_fail(p, JSON_ERR_MEMORY);
        return 0;
    }
    if (p->strict && !j1_utf8_valid(s.data, s.len)) {
        s.release();
        j1_fail(p, JSON_ERR_UTF8);
        return 0;
    }
    *out = s;
    return 1;
}

static int j1_digit(int c)
{
    return c >= '0' && c <= '9';
}

/* Every parsed number keeps its source text (`num_kind == 0`), so `1.0`,
   `1e3` and values beyond int64 all encode back byte for byte. */
static int j1_number(struct J1Parser *p, JsonRef *out)
{
    int start = p->pos;
    JsonRef r;
    Str lit;

    if (p->src[p->pos] == '-') p->pos = p->pos + 1;
    if (p->pos >= p->len || !j1_digit(p->src[p->pos])) {
        j1_fail(p, JSON_ERR_NUMBER);
        return 0;
    }
    if (p->src[p->pos] == '0') {
        p->pos = p->pos + 1;
        if (p->pos < p->len && j1_digit(p->src[p->pos])) {
            j1_fail(p, JSON_ERR_NUMBER);
            return 0;
        }
    } else {
        while (p->pos < p->len && j1_digit(p->src[p->pos]))
            p->pos = p->pos + 1;
    }
    if (p->pos < p->len && p->src[p->pos] == '.') {
        p->pos = p->pos + 1;
        if (p->pos >= p->len || !j1_digit(p->src[p->pos])) {
            j1_fail(p, JSON_ERR_NUMBER);
            return 0;
        }
        while (p->pos < p->len && j1_digit(p->src[p->pos]))
            p->pos = p->pos + 1;
    }
    if (p->pos < p->len && (p->src[p->pos] == 'e' || p->src[p->pos] == 'E')) {
        p->pos = p->pos + 1;
        if (p->pos < p->len && (p->src[p->pos] == '+' || p->src[p->pos] == '-'))
            p->pos = p->pos + 1;
        if (p->pos >= p->len || !j1_digit(p->src[p->pos])) {
            j1_fail(p, JSON_ERR_NUMBER);
            return 0;
        }
        while (p->pos < p->len && j1_digit(p->src[p->pos]))
            p->pos = p->pos + 1;
    }

    r = j1_node_make(JSON_TAG_NUM);
    lit = str_from_len(p->src + start, p->pos - start);
    if (lit.len < 0) {
        j1_node_destroy(r.p);
        j1_fail(p, JSON_ERR_MEMORY);
        return 0;
    }
    r.p->num_kind = 0;
    r.p->v.lit = lit;
    *out = r;
    return 1;
}

static int j1_value(struct J1Parser *p, JsonRef *out);

static int j1_object(struct J1Parser *p, JsonRef *out)
{
    JsonRef r = j1_node_make(JSON_TAG_OBJ);
    JsonObj *o = j1_obj_new();
    r.p->v.obj = o;
    p->depth = p->depth + 1;
    if (p->depth > J1_DEPTH_LIMIT) {
        j1_fail(p, JSON_ERR_DEPTH);
        j1_node_destroy(r.p);
        return 0;
    }
    p->pos = p->pos + 1;
    j1_ws(p);
    if (p->pos < p->len && p->src[p->pos] == '}') {
        p->pos = p->pos + 1;
        p->depth = p->depth - 1;
        *out = r;
        return 1;
    }
    while (1) {
        Str key;
        JsonRef val;
        j1_ws(p);
        if (p->pos >= p->len) {
            j1_fail(p, JSON_ERR_EOF);
            j1_node_destroy(r.p);
            return 0;
        }
        if (p->src[p->pos] != '"') {
            j1_fail(p, JSON_ERR_SYNTAX);
            j1_node_destroy(r.p);
            return 0;
        }
        if (!j1_string(p, &key)) {
            j1_node_destroy(r.p);
            return 0;
        }
        j1_ws(p);
        if (p->pos >= p->len || p->src[p->pos] != ':') {
            key.release();
            j1_fail(p, JSON_ERR_SYNTAX);
            j1_node_destroy(r.p);
            return 0;
        }
        p->pos = p->pos + 1;
        if (!j1_value(p, &val)) {
            key.release();
            j1_node_destroy(r.p);
            return 0;
        }
        if (!j1_obj_put(o, key, val)) {
            key.release();
            json_release(val);
            j1_fail(p, JSON_ERR_MEMORY);
            j1_node_destroy(r.p);
            return 0;
        }
        key.release();
        j1_ws(p);
        if (p->pos < p->len && p->src[p->pos] == ',') {
            p->pos = p->pos + 1;
            continue;
        }
        if (p->pos < p->len && p->src[p->pos] == '}') {
            p->pos = p->pos + 1;
            p->depth = p->depth - 1;
            *out = r;
            return 1;
        }
        j1_fail(p, JSON_ERR_SYNTAX);
        j1_node_destroy(r.p);
        return 0;
    }
}

static int j1_array(struct J1Parser *p, JsonRef *out)
{
    JsonRef r = j1_node_make(JSON_TAG_ARR);
    JsonArr *a = j1_arr_new();
    r.p->v.arr = a;
    p->depth = p->depth + 1;
    if (p->depth > J1_DEPTH_LIMIT) {
        j1_fail(p, JSON_ERR_DEPTH);
        j1_node_destroy(r.p);
        return 0;
    }
    p->pos = p->pos + 1;
    j1_ws(p);
    if (p->pos < p->len && p->src[p->pos] == ']') {
        p->pos = p->pos + 1;
        p->depth = p->depth - 1;
        *out = r;
        return 1;
    }
    while (1) {
        JsonRef val;
        if (!j1_value(p, &val)) {
            j1_node_destroy(r.p);
            return 0;
        }
        if (!j1_arr_push(a, val)) {
            json_release(val);
            j1_fail(p, JSON_ERR_MEMORY);
            j1_node_destroy(r.p);
            return 0;
        }
        j1_ws(p);
        if (p->pos < p->len && p->src[p->pos] == ',') {
            p->pos = p->pos + 1;
            continue;
        }
        if (p->pos < p->len && p->src[p->pos] == ']') {
            p->pos = p->pos + 1;
            p->depth = p->depth - 1;
            *out = r;
            return 1;
        }
        j1_fail(p, JSON_ERR_SYNTAX);
        j1_node_destroy(r.p);
        return 0;
    }
}

static int j1_lit_word(struct J1Parser *p, char *word, int n)
{
    int i;
    for (i = 0; i < n; i = i + 1) {
        if (p->pos + i >= p->len || p->src[p->pos + i] != word[i]) {
            j1_fail(p, JSON_ERR_SYNTAX);
            return 0;
        }
    }
    p->pos = p->pos + n;
    return 1;
}

static int j1_value(struct J1Parser *p, JsonRef *out)
{
    char c;
    j1_ws(p);
    if (p->pos >= p->len) {
        j1_fail(p, JSON_ERR_EOF);
        return 0;
    }
    c = p->src[p->pos];
    if (c == '{') return j1_object(p, out);
    if (c == '[') return j1_array(p, out);
    if (c == '"') {
        Str s;
        JsonRef r;
        if (!j1_string(p, &s)) return 0;
        r = j1_node_make(JSON_TAG_STR);
        r.p->v.s = s;
        *out = r;
        return 1;
    }
    if (c == 't' || c == 'f') {
        JsonRef r;
        int b = c == 't';
        if (b) {
            if (!j1_lit_word(p, "true", 4)) return 0;
        } else {
            if (!j1_lit_word(p, "false", 5)) return 0;
        }
        r = j1_node_make(JSON_TAG_BOOL);
        r.p->v.b = b;
        *out = r;
        return 1;
    }
    if (c == 'n') {
        if (!j1_lit_word(p, "null", 4)) return 0;
        *out = j1_node_make(JSON_TAG_NULL);
        return 1;
    }
    if (c == '-' || j1_digit(c)) return j1_number(p, out);
    j1_fail(p, JSON_ERR_SYNTAX);
    return 0;
}

static int j1_decode(char *text, int len, JsonRef *out, int strict)
{
    struct J1Parser p;
    JsonRef root = j1_empty();
    j1_last_error = JSON_OK;
    j1_err_pos = 0;
    j1_err_line = 0;
    j1_err_col = 0;
    if (out == 0) {
        j1_last_error = JSON_ERR_TYPE;
        return JSON_ERR_TYPE;
    }
    if (text == 0 || len <= 0) {
        j1_last_error = JSON_ERR_EOF;
        j1_err_pos = 0;
        j1_err_line = 1;
        j1_err_col = 1;
        return JSON_ERR_EOF;
    }
    p.src = text;
    p.len = len;
    p.pos = 0;
    p.depth = 0;
    p.err = 0;
    p.strict = strict;
    if (!j1_value(&p, &root)) {
        j1_last_error = p.err == 0 ? JSON_ERR_SYNTAX : p.err;
        return j1_last_error;
    }
    j1_ws(&p);
    if (p.pos != p.len) {
        j1_node_destroy(root.p);
        j1_last_error = JSON_ERR_TRAILING;
        j1_place(&p, p.pos);
        return JSON_ERR_TRAILING;
    }
    out->p = root.p;
    return JSON_OK;
}

pub int json_decode(char *text, int len, JsonRef *out)
{
    return j1_decode(text, len, out, 0);
}

pub int json_decode_strict(char *text, int len, JsonRef *out)
{
    return j1_decode(text, len, out, 1);
}

/* ------------------------------------------------------------- encoding */

static void j1_buf_grow(struct J1Buf *b, int need)
{
    int cap = b->cap == 0 ? 64 : b->cap;
    char *np;
    while (cap < need) cap = cap * 2;
    np = realloc(b->p, (size_t)cap);
    if (np == 0) abort();
    b->p = np;
    b->cap = cap;
}

static void j1_putc(struct J1Buf *b, int c)
{
    j1_buf_grow(b, b->len + 2);
    b->p[b->len] = c;
    b->len = b->len + 1;
}

static void j1_putn(struct J1Buf *b, char *s, int n)
{
    int i;
    for (i = 0; i < n; i = i + 1) j1_putc(b, s[i]);
}

static void j1_puts(struct J1Buf *b, char *s)
{
    j1_putn(b, s, (int)strlen(s));
}

static void j1_put_hex4(struct J1Buf *b, int v)
{
    char *digits = "0123456789abcdef";
    j1_putc(b, digits[(v >> 12) & 0xF]);
    j1_putc(b, digits[(v >> 8) & 0xF]);
    j1_putc(b, digits[(v >> 4) & 0xF]);
    j1_putc(b, digits[v & 0xF]);
}

/* Length-driven on purpose: a string value may contain U+0000, which is
   written as `\u0000` instead of truncating the output. */
static void j1_enc_bytes(struct J1Buf *b, char *s, int n)
{
    int i;
    j1_putc(b, '"');
    for (i = 0; i < n; i = i + 1) {
        int c = s[i];
        if (c < 0) c = c + 256;
        if (c == '"') {
            j1_puts(b, "\\\"");
        } else if (c == '\\') {
            j1_puts(b, "\\\\");
        } else if (c == 8) {
            j1_puts(b, "\\b");
        } else if (c == 12) {
            j1_puts(b, "\\f");
        } else if (c == 10) {
            j1_puts(b, "\\n");
        } else if (c == 13) {
            j1_puts(b, "\\r");
        } else if (c == 9) {
            j1_puts(b, "\\t");
        } else if (c < 0x20) {
            j1_puts(b, "\\u");
            j1_put_hex4(b, c);
        } else {
            j1_putc(b, c);
        }
    }
    j1_putc(b, '"');
}

static void j1_enc_double(struct J1Buf *b, double d)
{
    char tmp[64];
    int k;
    /* NaN compares false against everything, so it needs its own check. */
    if (d != d) {
        b->bad = JSON_ERR_RANGE;
        return;
    }
    if (d > 1.7976931348623157e308 || d < -1.7976931348623157e308) {
        b->bad = JSON_ERR_RANGE;
        return;
    }
    for (k = 1; k <= 17; k = k + 1) {
        snprintf(tmp, sizeof(tmp), "%.*g", k, d);
        if (strtod(tmp, 0) == d) break;
    }
    j1_puts(b, tmp);
}

static void j1_enc(struct J1Buf *b, JsonRef v, int depth);

static void j1_enc_obj(struct J1Buf *b, JsonObj *o, int depth)
{
    int i;
    j1_putc(b, '{');
    for (i = 0; i < o->len; i = i + 1) {
        if (i > 0) j1_putc(b, ',');
        j1_enc_bytes(b, o->keys[i].data, o->keys[i].len);
        j1_putc(b, ':');
        j1_enc(b, o->vals[i], depth + 1);
        if (b->bad != 0) return;
    }
    j1_putc(b, '}');
}

static void j1_enc_arr(struct J1Buf *b, JsonArr *a, int depth)
{
    int i;
    j1_putc(b, '[');
    for (i = 0; i < a->len; i = i + 1) {
        if (i > 0) j1_putc(b, ',');
        j1_enc(b, a->items[i], depth + 1);
        if (b->bad != 0) return;
    }
    j1_putc(b, ']');
}

static void j1_enc(struct J1Buf *b, JsonRef v, int depth)
{
    if (b->bad != 0) return;
    if (v.p == 0) {
        j1_puts(b, "null");
        return;
    }
    if (depth > J1_ENC_DEPTH_LIMIT) {
        b->bad = JSON_ERR_CYCLE;
        return;
    }
    if (v.p->tag == JSON_TAG_NULL) {
        j1_puts(b, "null");
    } else if (v.p->tag == JSON_TAG_BOOL) {
        j1_puts(b, v.p->v.b ? "true" : "false");
    } else if (v.p->tag == JSON_TAG_NUM) {
        if (v.p->num_kind == 0) {
            j1_putn(b, v.p->v.lit.data, v.p->v.lit.len);
        } else if (v.p->num_kind == 1) {
            char tmp[32];
            snprintf(tmp, sizeof(tmp), "%lld", v.p->v.i);
            j1_puts(b, tmp);
        } else {
            j1_enc_double(b, v.p->v.d);
        }
    } else if (v.p->tag == JSON_TAG_STR) {
        j1_enc_bytes(b, v.p->v.s.data, v.p->v.s.len);
    } else if (v.p->tag == JSON_TAG_OBJ) {
        j1_enc_obj(b, v.p->v.obj, depth);
    } else if (v.p->tag == JSON_TAG_ARR) {
        j1_enc_arr(b, v.p->v.arr, depth);
    } else {
        b->bad = JSON_ERR_TYPE;
    }
}

pub char *json_encode(JsonRef root)
{
    struct J1Buf b;
    b.p = 0;
    b.len = 0;
    b.cap = 0;
    b.bad = 0;
    j1_last_error = JSON_OK;
    if (root.p == 0) {
        j1_last_error = JSON_ERR_TYPE;
        return 0;
    }
    j1_enc(&b, root, 0);
    if (b.bad != 0) {
        j1_last_error = b.bad;
        free(b.p);
        return 0;
    }
    j1_putc(&b, 0);
    b.len = b.len - 1;
    return b.p;
}

/* ------------------------------------------------------------- conversions */

static int j1_lit_to_int(Str s, long long *out)
{
    int i = 0;
    int neg = 0;
    unsigned long long acc = 0;
    unsigned long long limit;
    if (s.len <= 0) return JSON_ERR_TYPE;
    if (s.data[0] == '-') {
        neg = 1;
        i = 1;
    }
    if (i >= s.len) return JSON_ERR_TYPE;
    limit = neg ? (9223372036854775807ULL + 1ULL) : 9223372036854775807ULL;
    while (i < s.len) {
        int c = s.data[i];
        int d;
        if (c < '0' || c > '9') return JSON_ERR_TYPE;
        d = c - '0';
        if (acc > (limit - (unsigned long long)d) / 10ULL) return JSON_ERR_RANGE;
        acc = acc * 10ULL + (unsigned long long)d;
        i = i + 1;
    }
    *out = neg ? (long long)(0ULL - acc) : (long long)acc;
    return JSON_OK;
}

pub int json_tag(JsonRef v)
{
    if (v.p == 0) return -1;
    return v.p->tag;
}

pub int json_is_null(JsonRef v)
{
    return v.p != 0 && v.p->tag == JSON_TAG_NULL;
}

pub int json_as_bool(JsonRef v, int *out)
{
    if (v.p == 0 || out == 0 || v.p->tag != JSON_TAG_BOOL) return JSON_ERR_TYPE;
    *out = v.p->v.b ? 1 : 0;
    return JSON_OK;
}

pub int json_as_int(JsonRef v, long long *out)
{
    if (v.p == 0 || out == 0) return JSON_ERR_TYPE;
    if (v.p->tag == JSON_TAG_BOOL) {
        *out = v.p->v.b ? 1 : 0;
        return JSON_OK;
    }
    if (v.p->tag != JSON_TAG_NUM) return JSON_ERR_TYPE;
    if (v.p->num_kind == 1) {
        *out = v.p->v.i;
        return JSON_OK;
    }
    if (v.p->num_kind == 2) return JSON_ERR_TYPE;
    return j1_lit_to_int(v.p->v.lit, out);
}

pub int json_as_double(JsonRef v, double *out)
{
    if (v.p == 0 || out == 0 || v.p->tag != JSON_TAG_NUM) return JSON_ERR_TYPE;
    if (v.p->num_kind == 1) {
        *out = (double)v.p->v.i;
        return JSON_OK;
    }
    if (v.p->num_kind == 2) {
        *out = v.p->v.d;
        return JSON_OK;
    }
    {
        char *tmp = str_c_str(v.p->v.lit);
        double d;
        if (tmp == 0) return JSON_ERR_MEMORY;
        d = strtod(tmp, 0);
        free(tmp);
        /* 1e999 parses to inf; the raw literal stays valid JSON, but the
           double conversion must answer RANGE and leave `out` untouched. */
        if (d != d || d > 1.7976931348623157e308 || d < -1.7976931348623157e308) {
            return JSON_ERR_RANGE;
        }
        *out = d;
        return JSON_OK;
    }
}

pub char *json_as_str(JsonRef v, int *len)
{
    if (v.p == 0 || v.p->tag != JSON_TAG_STR) return 0;
    if (len != 0) *len = v.p->v.s.len;
    return v.p->v.s.data;
}

pub int json_obj_len(JsonRef v)
{
    if (v.p == 0 || v.p->tag != JSON_TAG_OBJ || v.p->v.obj == 0) return -1;
    return v.p->v.obj->len;
}

pub int json_arr_len(JsonRef v)
{
    if (v.p == 0 || v.p->tag != JSON_TAG_ARR || v.p->v.arr == 0) return -1;
    return v.p->v.arr->len;
}

pub JsonRef json_member(JsonRef v, Str key)
{
    JsonObj *o;
    int *slot;
    if (v.p == 0 || v.p->tag != JSON_TAG_OBJ || key.len < 0) return j1_empty();
    o = v.p->v.obj;
    if (o == 0) return j1_empty();
    slot = o->index->get(key);
    if (slot == 0) return j1_empty();
    return o->vals[*slot];
}

pub char *json_obj_key_at(JsonRef v, int i, int *len)
{
    JsonObj *o;
    if (v.p == 0 || v.p->tag != JSON_TAG_OBJ || i < 0) return 0;
    o = v.p->v.obj;
    if (o == 0 || i >= o->len) return 0;
    if (len != 0) *len = o->keys[i].len;
    return o->keys[i].data;
}

/* ------------------------------------------------- members and arrays */

/* R-D-09 implementation. Two passes: the first rejects malformed paths and
   type conflicts before any mutation; the second creates the missing
   intermediates and stores the leaf. A path-segment `Str` allocation failure
   in the second pass can leave the created prefix behind and answers
   JSON_ERR_MEMORY; node/container allocation aborts through j1_alloc. */
pub int json_set(JsonRef root, Str path, JsonRef value)
{
    JsonRef cur;
    JsonRef child;
    JsonRef fresh;
    Str seg;
    int start;
    int i;
    int last;
    int missing;

    if (root.p == 0 || root.p->tag != JSON_TAG_OBJ) return JSON_ERR_TYPE;
    if (path.data == 0 || path.len <= 0) return JSON_ERR_RANGE;
    if (value.p == 0) return JSON_ERR_TYPE;

    cur = root;
    start = 0;
    missing = 0;
    for (i = 0; i <= path.len; i = i + 1) {
        last = (i == path.len);
        if (!last && path.data[i] != '.') continue;
        if (i == start) return JSON_ERR_RANGE;
        if (last) break;
        if (missing) { start = i + 1; continue; }
        seg = str_from_len(path.data + start, i - start);
        if (seg.len < 0) return JSON_ERR_MEMORY;
        child = json_member(cur, seg);
        seg.release();
        start = i + 1;
        if (child.p == 0) { missing = 1; continue; }
        if (child.p->tag != JSON_TAG_OBJ) return JSON_ERR_TYPE;
        cur = child;
    }

    cur = root;
    start = 0;
    for (i = 0; i <= path.len; i = i + 1) {
        last = (i == path.len);
        if (!last && path.data[i] != '.') continue;
        if (i == start) return JSON_ERR_RANGE;
        seg = str_from_len(path.data + start, i - start);
        if (seg.len < 0) return JSON_ERR_MEMORY;
        if (last) {
            json_retain(value);
            j1_obj_store(cur, seg, value);
            child = json_member(cur, seg);
            seg.release();
            return child.p == 0 ? JSON_ERR_MEMORY : JSON_OK;
        }
        child = json_member(cur, seg);
        if (child.p == 0) {
            fresh = j1_new_obj_ref();
            j1_obj_store(cur, seg, fresh);
            child = json_member(cur, seg);
            if (child.p == 0) {
                seg.release();
                return JSON_ERR_MEMORY;
            }
        }
        cur = child;
        seg.release();
        start = i + 1;
    }
    return JSON_OK;
}

impl JsonRef {
    /* Subscript protocol entry: `v["key"]` lowers to `v.get("key")` (Phase 52).
       The `char *` parameter is the single documented exception to the Str-key
       rule, because that is the shape the protocol passes a literal in. It is
       converted to `Str` for the lookup and never stored. The answer is a
       borrowed handle: retain it if it must outlive its container. */
    pub JsonRef get(char *key)
    {
        Str k;
        JsonRef r;
        if (self->p == 0 || self->p->tag != JSON_TAG_OBJ || key == 0) return j1_empty();
        k = str_from(key);
        if (k.len < 0) return j1_empty();
        r = json_member(*self, k);
        k.release();
        return r;
    }

    /* Subscript protocol entry: `v["key"] = x` lowers to `v.set("key", x)`.
       The write is shared (ADR-0003): the container keeps its own reference and
       the caller keeps and releases its handle. The key is converted to `Str`
       and deep-copied by the container. */
    pub void set(char *key, JsonRef value)
    {
        Str k;
        if (self->p == 0 || self->p->tag != JSON_TAG_OBJ || key == 0) return;
        k = str_from(key);
        if (k.len < 0) return;
        json_retain(value);
        j1_obj_store(*self, k, value);
        k.release();
    }

    /* Key presence with the same comparison `json_member` uses, so an embedded
       U+0000 is data and a missing key is distinguishable from an explicit
       null. */
    pub int has(Str key)
    {
        JsonObj *o;
        if (self->p == 0 || self->p->tag != JSON_TAG_OBJ || key.len < 0) return 0;
        o = self->p->v.obj;
        if (o == 0) return 0;
        return o->index->has(key);
    }

    /* 0.1.0 array read entry (Q-2 A). `v[0]` does not exist in v0.52.0: the
       subscript protocol only matches a single `char *` key. A missing index,
       a negative index and a non-array all answer the empty handle; a present
       JSON null answers a non-empty handle whose tag is JSON_TAG_NULL. The
       length is available through `json_arr_len`. */
    pub JsonRef get_idx(int i)
    {
        JsonArr *a;
        if (self->p == 0 || self->p->tag != JSON_TAG_ARR || i < 0) return j1_empty();
        a = self->p->v.arr;
        if (a == 0 || i >= a->len) return j1_empty();
        return a->items[i];
    }

    /* Append; the container keeps its own reference, so the caller keeps and
       releases its handle. */
    pub void push(JsonRef v)
    {
        JsonArr *a;
        if (self->p == 0 || self->p->tag != JSON_TAG_ARR) return;
        a = self->p->v.arr;
        if (a == 0) return;
        json_retain(v);
        if (!j1_arr_push(a, v)) json_release(v);
    }

    /* Overwrite an existing index only: no growth, no element shift. Out of
       range (and a non-array, which has no valid index) answers
       JSON_ERR_RANGE and leaves the array untouched. The new value is retained
       before the old one is released, so `set_idx(i, get_idx(i))` is safe. */
    pub int set_idx(int i, JsonRef v)
    {
        JsonArr *a;
        if (self->p == 0 || self->p->tag != JSON_TAG_ARR || i < 0) return JSON_ERR_RANGE;
        a = self->p->v.arr;
        if (a == 0 || i >= a->len) return JSON_ERR_RANGE;
        json_retain(v);
        json_release(a->items[i]);
        a->items[i] = v;
        return JSON_OK;
    }

    /* Insert or overwrite a string value. The key is deep-copied by the
       container, so the caller still owns `key` and releases it. */
    pub void set_str(Str key, char *text, int len)
    {
        JsonRef v = j1_node_make(JSON_TAG_STR);
        Str s = str_from_len(text, len);
        if (s.len < 0) {
            j1_node_destroy(v.p);
            return;
        }
        v.p->v.s = s;
        j1_obj_store(*self, key, v);
    }

    pub void set_int(Str key, long long value)
    {
        j1_obj_store(*self, key, j1_num_int(value));
    }

    pub void set_double(Str key, double value)
    {
        j1_obj_store(*self, key, j1_num_double(value));
    }

    pub void set_bool(Str key, int value)
    {
        JsonRef v = j1_node_make(JSON_TAG_BOOL);
        v.p->v.b = value ? 1 : 0;
        j1_obj_store(*self, key, v);
    }

    pub void set_null(Str key)
    {
        j1_obj_store(*self, key, j1_node_make(JSON_TAG_NULL));
    }

    /* Drops one member: releases the value reference and the key copy, shifts
       the tail left so insertion order survives, then rebuilds the key index. */
    pub void remove(Str key)
    {
        JsonObj *o;
        int *slot;
        int i, j;
        if (self->p == 0 || self->p->tag != JSON_TAG_OBJ || key.len < 0) return;
        o = self->p->v.obj;
        if (o == 0) return;
        slot = o->index->get(key);
        if (slot == 0) return;
        i = *slot;
        json_release(o->vals[i]);
        free(o->keys[i].data);
        o->keys[i].data = 0;
        o->keys[i].len = -1;
        for (j = i; j + 1 < o->len; j = j + 1) {
            o->keys[j] = o->keys[j + 1];
            o->vals[j] = o->vals[j + 1];
        }
        o->len = o->len - 1;
        j1_obj_reindex(o);
    }
}
