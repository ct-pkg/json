/*
 * 6c) 失败对照：对临时值调方法。
 *
 * 构建（在仓库根目录）：
 *   CT_STD_DIR=/Users/samxx/trae-ws/ct-lang/lib/std \
 *     ct build docs/snippets/fail/temp_receiver.ct -I src -o /tmp/f_temp
 *
 * 照现状记录，不编译。实际报错是：
 *   error: method receiver must be a variable, an element, a call or a field chain
 * 注意它不是三级链那条 "a method call on a temporary ..."。
 */
#include <string.h>

import json;

int main(void)
{
    JsonRef doc;
    Str k = str_from("host");
    if (json_decode("{\"server\":{\"host\":\"h\"}}", 24, &doc) != JSON_OK) return 1;
    int present = doc["server"].has(k);
    k.release();
    json_free(doc);
    return present == 0;
}
