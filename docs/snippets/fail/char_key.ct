/*
 * 6a) 失败对照：char* 键传给收 Str 的 API。
 *
 * 构建（在仓库根目录）：
 *   CT_STD_DIR=/Users/samxx/trae-ws/ct-lang/lib/std \
 *     ct build docs/snippets/fail/char_key.ct -I src -o /tmp/f_char
 *
 * 照现状记录，不编译。诊断分两步：CT 只报 warning，真正拦下的是 C 编译器。
 */
#include <string.h>

import json;

int main(void)
{
    JsonRef doc;
    if (json_decode("{}", 2, &doc) != JSON_OK) return 1;
    JsonRef m = json_member(doc, "k");
    json_free(doc);
    return m.p == 0;
}
