#include <string.h>

import json;

int main(void)
{
    JsonRef doc;
    if (json_decode("{\"a\":{\"b\":{\"c\":1}}}", 19, &doc) != JSON_OK) return 1;
    JsonRef c = doc["a"]["b"]["c"];
    json_free(doc);
    return c.p == 0;
}
