/*
 * 3) 两级链：哪些位置可用。
 *
 * 构建 / 运行（在仓库根目录）：
 *   CT_STD_DIR=/Users/samxx/trae-ws/ct-lang/lib/std \
 *     ct build docs/snippets/chain.ct -I src -o /tmp/s_chain && /tmp/s_chain
 *
 * 三级链、方法结果链与下标结果作接收者见 chain3.ct（CT v0.62.0 起可用）；
 * 链式结果直接作函数实参仍不可用，登记在 issues/JSON-5.md。
 */
#include <stdio.h>
#include <string.h>

import json;

int main(void)
{
    char *text = "{\"a\":{\"b\":{\"c\":7}}}";
    JsonRef doc;
    JsonRef b;
    JsonRef c;
    long long n = 0;

    if (json_decode(text, (int)strlen(text), &doc) != JSON_OK) return 1;

    /* 位置一：声明初始化。 */
    JsonRef d = doc["a"]["b"];
    printf("decl init: tag=%d\n", json_tag(d));

    /* 位置二：赋值右值。 */
    b = doc["a"]["b"];
    printf("assign rhs: tag=%d\n", json_tag(b));

    /* 两级链的结果落到局部变量；三级直链见 chain3.ct。 */
    c = b["c"];
    printf("third level: tag=%d value=%d\n",
           json_tag(c), json_as_int(c, &n) == JSON_OK && n == 7);

    json_free(doc);
    return 0;
}
