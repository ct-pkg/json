/* (c) 设计拒绝：CT 的可选下标写作 `?[`，不认 JS 的 `?.[` | 目标 12d —— 当前不编译。 */
#include <stdio.h>
#include <string.h>
import json;

int main(void)
{
    char *text = "{\"server\":{\"host\":\"db.local\"}}";
    JsonRef doc;
    JsonRef server;
    if (json_decode(text, (int)strlen(text), &doc) != JSON_OK) return 1;

    server = doc?.["server"];    /* `?.` 后必须跟字段或方法名 */
    printf("optional subscript-dot tag=%d\n", json_tag(server));

    json_free(doc);
    return 0;
}
