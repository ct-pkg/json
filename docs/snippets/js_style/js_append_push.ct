/* (a) 今天可用 | 目标 13：追加的当前写法 —— push 之后长度与下标的变化。 */
#include <stdio.h>
#include <string.h>
import json;

int main(void)
{
    char *text = "{\"items\":[1]}";
    JsonRef doc;
    JsonRef items;
    JsonRef two;
    JsonRef got;
    JsonRef oob;
    int before;
    int after;

    if (json_decode(text, (int)strlen(text), &doc) != JSON_OK) return 1;
    if (json_decode("2", 1, &two) != JSON_OK) return 1;

    items = doc["items"];
    before = json_arr_len(items);
    items.push(two);                       /* 追加：长度 +1，新元素落在末尾 */
    after = json_arr_len(items);

    got = items.get_idx(1);                /* 追加后的新下标 */
    oob = items.get_idx(after);            /* 追加后仍越界的下标 */

    printf("len %d -> %d; [1] tag=%d; [%d] empty=%d\n",
           before, after, json_tag(got), after, oob.p == 0);

    json_release(two);
    json_free(doc);
    return 0;
}
